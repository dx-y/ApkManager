{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ApkManager",
  "version": "5.0.1",
  "identifier": "com.dxy.apkmanager",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "APK 管家",
        "width": 900,
        "height": 980,
        "minWidth": 680,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "publisher": "dx-y",
    "copyright": "© 2026 dx-y · 源码仓库 https://github.com/dx-y/ApkManager",
    "homepage": "https://github.com/dx-y/ApkManager",
    "shortDescription": "APK 管家 · adb 直连安装卸载（dx-y/ApkManager）",
    "longDescription": "APK 管家：拖入即装，绕开应用宝「高风险」拦截。作者 dx-y，源码仓库 https://github.com/dx-y/ApkManager"
  }
}