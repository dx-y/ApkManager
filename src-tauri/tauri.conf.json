{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ApkManager",
  "version": "5.0.0",
  "identifier": "com.dxy.apkmanager",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "APK 管家",
        "width": 900,
        "height": 980,
        "minWidth": 680,
        "minHeight": 600,
        "resizable": true,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
